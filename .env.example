# ─────────────────────────────────────────────────────────────
# AMAANAT environment. Copy to .env (never commit .env).
# Everything here is SERVER-SIDE ONLY. The browser receives only
# RAZORPAY_KEY_ID (public by design) via /api/checkout.
# ─────────────────────────────────────────────────────────────

# Database driver: supabase | pglite | (empty = auto: supabase if keys set, else none)
#   pglite = local development database in ./.local-db (NOT for production)
DATABASE_DRIVER=

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Product image storage: supabase (production) | local (dev only). Empty = automatic.
STORAGE_DRIVER=
# Public Supabase Storage bucket for product images and the logo.
SUPABASE_STORAGE_BUCKET=product-images

# Razorpay — TEST MODE keys (Dashboard → Test mode → API Keys). Must start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add https://<host>/api/webhooks/razorpay
# events: payment.captured, payment.failed, payment.authorized, order.paid,
#         refund.processed, refund.failed, refund.created
RAZORPAY_WEBHOOK_SECRET=
# Live keys are refused unless this is "true" (Part 1 is test mode only).
RAZORPAY_ALLOW_LIVE=false

# App
PORT=3000
NODE_ENV=development
# Public origin, e.g. https://amaanat.example — used for canonical URLs, sitemap,
# robots.txt (indexing is only allowed when this is set in production) and Secure cookies.
APP_BASE_URL=
# Optional extra allowed Origin for API calls (no wildcard support by design).
CORS_ORIGIN=
# Set true behind a proxy that sets X-Forwarded-* (auto-true on Vercel).
TRUST_PROXY=false
STORE_NAME=Amaanat
# Minutes a checkout holds stock before it is released (5–120).
RESERVATION_MINUTES=30
# Bearer secret for /api/internal/reconcile (Vercel Cron sends it automatically).
CRON_SECRET=

# Local auth token secret (DATABASE_DRIVER=pglite only).
LOCAL_AUTH_SECRET=

# Contact (not used by code yet; settings live in site_settings)
ADMIN_EMAIL=
WHATSAPP_BUSINESS_NUMBER=
STORE_CONTACT_EMAIL=
